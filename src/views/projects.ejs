<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <ul class="project-list">
            <% projects.forEach(project=> { %>
                <li>
                    <span class="project-date">
                        <%= project.date.toLocaleDateString('en-US', { dateStyle: 'medium' }) %>:
                    </span>
                    <a href="/project/<%= project.project_id %>"><strong>
                            <%= project.title %>
                        </strong></a>
                    <a class="project-organization" href="/organization/<%= project.organization_id %>"><em>(<%=
                                project.organization_name %>
                                )</em></a>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>