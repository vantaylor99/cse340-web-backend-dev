<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <li>
                    <span class="project-date"><%= project.date.toLocaleDateString('en-US', { dateStyle: 'medium' }) %>:</span>
                    <strong><%= project.title %></strong>
                    <em>(<%= project.organization_name %>)</em>
                </li>
            <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>
