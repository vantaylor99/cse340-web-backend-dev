<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <% categories.forEach(category=> { %>
                <li><a href="#<%= encodeURIComponent(category.name) %>">
                        <%= category.name %>
                    </a></li>
                <% }); %>
        </ul>

    </main>
    <%- include('partials/footer') %>